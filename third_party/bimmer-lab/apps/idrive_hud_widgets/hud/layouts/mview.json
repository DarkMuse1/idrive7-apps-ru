{
  "schemaVersion": 2,
  "name": "M view",
  "slots": [
    {
      "id": "1",
      "where": "right, bottom",
      "default": "oil"
    }
  ],
  "_about": "M view HUD, to go with the M view cluster theme, generated by design/gen_hud.py: the rev band and its scale across the top (scale and colour zones follow the Redline setting), the gear big with the drive mode under it, the speed in the other unit (km/h when the car shows mph, and the other way round) and one readout slot bottom right. Fitted (Nov 9 2026) to the HUD as BMW's own height-adjust frame shows it, x 120..680, y 100..380, and kept clear of the bottom-left x 120..350, y 235..380, where BMW draws its speed and speed-limit sign (and in Sport its rev band) over ours. To change it, copy this file into the app data folder layouts/ (scripts/deploy.sh); the app reloads it by itself. Widget types and tokens: see the header of hud.js.",
  "widgets": [
    {
      "id": "revbar",
      "type": "revbar",
      "x": 130,
      "y": 112,
      "w": 540,
      "h": 48,
      "top": 6,
      "barH": 28,
      "slant": 12,
      "over": 1000,
      "class": "overlay",
      "z": 10
    },
    {
      "id": "rpm_scale",
      "type": "scale",
      "font": "small",
      "x": 130,
      "y": 162,
      "w": 528,
      "h": 17,
      "over": 1000,
      "redFrom": true,
      "color": "fg",
      "class": "content",
      "z": 5
    },
    {
      "id": "gear",
      "type": "text",
      "z": 10,
      "x": 360,
      "y": 232,
      "w": 100,
      "h": 73,
      "text": "{{gearnum}}",
      "font": "hero",
      "color": "fg",
      "align": "center",
      "hotWhen": "now",
      "glow": true,
      "class": "overlay"
    },
    {
      "id": "mode",
      "type": "text",
      "z": 10,
      "x": 355,
      "y": 328,
      "w": 110,
      "h": 17,
      "text": "{{mode}}",
      "font": "small",
      "color": "dim",
      "align": "center",
      "spacing": 1,
      "class": "content"
    },
    {
      "id": "speed2",
      "type": "text",
      "z": 10,
      "x": 482,
      "y": 242,
      "w": 120,
      "h": 33,
      "text": "{{speed2}}",
      "font": "big",
      "color": "fg",
      "align": "right",
      "class": "overlay"
    },
    {
      "id": "speed2_u",
      "type": "text",
      "z": 10,
      "x": 608,
      "y": 252,
      "w": 62,
      "h": 20,
      "text": "{{u:speed2}}",
      "font": "label",
      "color": "dim",
      "align": "left",
      "class": "overlay"
    },
    {
      "id": "oil_label",
      "type": "text",
      "z": 10,
      "x": 530,
      "y": 302,
      "w": 140,
      "h": 17,
      "text": "{{slotHeadU:1}}",
      "font": "small",
      "color": "dim",
      "align": "right",
      "spacing": 1,
      "class": "content",
      "showWhen": "abnormal",
      "navHide": true
    },
    {
      "id": "oil",
      "type": "text",
      "z": 10,
      "x": 570,
      "y": 322,
      "w": 100,
      "h": 27,
      "text": "{{slot:1}}{{slotSuffix:1}}",
      "font": "mid",
      "color": "fg",
      "align": "right",
      "slot": "1",
      "fit": [
        "label"
      ],
      "class": "overlay",
      "showWhen": "abnormal",
      "navHide": true
    },
    {
      "id": "nav",
      "type": "nav",
      "x": 470,
      "y": 300,
      "w": 200,
      "h": 76,
      "toggle": "!navDirections=off",
      "class": "overlay",
      "z": 20
    },
    {
      "id": "greeting",
      "type": "text",
      "z": 10,
      "x": 380,
      "y": 200,
      "w": 280,
      "h": 20,
      "text": "{{greeting}}",
      "font": "label",
      "color": "greet",
      "align": "center",
      "spacing": 1,
      "navHide": true,
      "class": "overlay"
    }
  ]
}
