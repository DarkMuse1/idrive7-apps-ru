{
  "schemaVersion": 2,
  "name": "Vector",
  "_about": "Vector HUD, to go with the Vector cluster theme, generated by design/gen_hud.py: a segmented shift bar across the top, the gear big on the left, oil, coolant and boost as rings, and bottom right the song playing (the head unit's now playing: title, artist, time), or range and outside temperature while nothing plays. Fitted (Nov 9 2026) to the HUD as BMW's own height-adjust frame shows it, x 120..680, y 100..380, and kept clear of the bottom-left x 120..350, y 235..380, where BMW draws its speed and speed-limit sign (and in Sport its rev band) over ours. To change it, copy this file into the app data folder layouts/ (scripts/deploy.sh); the app reloads it by itself. Widget types and tokens: see the header of hud.js.",
  "widgets": [
    {
      "id": "revs",
      "type": "shiftbar",
      "x": 130,
      "y": 110,
      "w": 540,
      "h": 14,
      "segments": 40,
      "class": "overlay",
      "z": 10
    },
    {
