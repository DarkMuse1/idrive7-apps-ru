      "z": 10,
      "x": 140,
      "y": 150,
      "w": 120,
      "h": 73,
      "text": "{{gearnum}}",
      "font": "hero",
      "color": "fg",
      "align": "center",
      "hotWhen": "now",
      "glow": true,
      "class": "overlay"
    },
    {
      "id": "oil_arc",
