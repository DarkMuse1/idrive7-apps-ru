{
  "id": "drive_recorder_lab",
  "title": "Drive Recorder",
  "version": "0.4.8",
  "vendor": "custom",
  "loggingId": "ODR2",
  "iconGlyph": "DR",
  "description": "Drive Recorder: experimental ICAM recording, archive and playback while parked. Password access.",
  "signals": {
    "de.bmw.infotainment.video.cameraproxy.ICAM2Proxy": {
      "_instances": "1",
      "_methods": [
        "changeState"
      ],
      "currentState": "r"
    },
    "de.bmw.infotainment.video.cameraproxy.CameraProxy": {
      "_instances": "1",
      "_methods": [
        "clientAttach",
        "clientDetach"
      ]
    },
    "de.bmw.infotainment.video.videobuffer.VideoBuffer": {
      "_instances": "VideoBuffer",
      "_methods": [
        "startRecording",
        "storeVideo"
      ],
      "currentStatus": "r",
      "currentConfiguration": "r"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.telematic.provisioning.Provisioning": {
      "_instances": "1",
      "_broadcasts": [
        "provisioningDataJSON"
      ],
      "_methods": [
        "getValue",
        "getValueJSON",
        "setFilterForProvisioningData"
      ],
      "provisioningDataState": "r"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ],
      "tasuModeStatus": "r"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Drive Recorder",
      "chrome": false,
      "buttons": [
        [
          "PREV",
          "Back through items"
        ],
        [
          "NEXT",
          "Next"
        ],
        [
          "ENTER",
          "Select"
        ],
        [
          "HOME",
          "Recording"
        ]
      ],
      "bar": false,
      "hmiBar": false
    }
  ],
  "settings": [],
  "maxDiskUsage": 268435456,
  "internet": true,
  "texts": {
    "ru": {
      "title": "Видеорегистратор",
      "description": "Drive Recorder: экспериментальная запись ICAM, архив и просмотр на стоянке. Доступ по паролю."
    }
  }
}
