      "default": "auto",
      "options": [
        [
          "auto",
          "Automatic"
        ],
        [
          "software",
          "Software"
        ]
      ]
    }
  ],
  "requires": {
    "idrive7-renderd": "2.1.10",
    "mgu-inputgate": "1.0.0",
    "mgu-ambient-rgb": "0.1.3"
  },
  "texts": {
    "ru": {
      "title": "Подсветка",
      "description": "Произвольный RGB-цвет подсветки, реальные зоны, яркость и сохранённые цвета. Закрытый модуль загружается после ввода пароля."
    }
  }
