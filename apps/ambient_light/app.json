      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ],
      "tasuModeStatus": "r"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ambient Lighting",
      "buttons": [
        [
          "BTN_PREV",
          "Back through menu"
        ],
        [
          "BTN_NEXT",
          "Next"
        ],
        [
          "BTN_SELECT",
          "Select"
        ],
        [
          "BTN_BACK",
          "Back"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ],
      "bar": false,
      "hmiBar": false
    }
  ],
  "settings": [
    {
      "key": "theme",
      "label": "Appearance",
      "type": "choice",
      "default": "mgu_tools",
      "options": [
        [
          "mgu_tools",
          "MGU Tools"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Layout",
