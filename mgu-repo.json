{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "build": {
      "python": "tools/build_official_ru.py",
      "args": [
        "{id}",
        "--language",
        "ru"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": [
        "doom"
      ],
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    },
    "exclude": [
      "ambient_light",
      "light_show",
      "drive_recorder_lab",
      "mgu_unified",
      "aa_cluster_companion"
    ]
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps (iDrive 7 and iDrive 8)",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/inputgate/tool",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start (iDrive 7 and iDrive 8)",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-ambient-rgb",
      "path": "tools/mgu-ambient-rgb"
    }
  ],
  "components": [
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0",
        "mgu-ambient-rgb": "0.1.3"
      },
      "build": {
        "python": "tools/protected-apps/kit/tools/build.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "network": [
          "doom"
        ]
      },
      "id": "ambient_light",
      "kind": "app",
      "path": "apps/ambient_light"
    },
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "tools/build_drive_recorder.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      },
      "id": "drive_recorder_lab",
      "kind": "app",
      "path": "apps/drive_recorder_lab"
    },
    {
      "id": "light_show",
      "kind": "app",
      "path": "apps/light_show",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "uninstallable": true,
      "requires": {
        "mgu-deploy": "0.7.5"
      },
      "build": {
        "python": "tools/build_light_show.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      }
    },
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0"
      },
      "id": "mgu_unified",
      "kind": "app",
      "path": "apps/mgu_unified",
      "build": {
        "python": "tools/protected-apps/kit/tools/build.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      }
    },
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0"
      },
      "id": "aa_cluster_companion",
      "kind": "app",
      "path": "apps/aa_cluster_companion",
      "build": {
        "python": "tools/protected-apps/kit/tools/build.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      }
    },
    {
      "id": "cluster_centre",
      "kind": "app",
      "path": "third_party/eroobeeroo-cluster/apps/cluster_centre",
      "manifest": "app.json",
      "mguHmi": [
        "ID7"
      ],
      "build": {
        "python": "tools/build_source_ru.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      },
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "cluster-render": "0.4.2"
      }
    },
    {
      "id": "cluster_info",
      "kind": "app",
      "path": "third_party/eroobeeroo-cluster/apps/cluster_info",
      "manifest": "app.json",
      "mguHmi": [
        "ID7"
      ],
      "build": {
        "python": "tools/build_source_ru.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      },
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "cluster-render": "0.4.2"
      }
    },
    {
      "id": "cluster_layouts",
      "kind": "app",
      "path": "third_party/eroobeeroo-cluster/apps/cluster_layouts",
      "manifest": "app.json",
      "mguHmi": [
        "ID7"
      ],
      "build": {
        "python": "tools/build_source_ru.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      },
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "cluster-render": "0.4.2"
      }
    },
    {
      "id": "cluster_themes",
      "kind": "app",
      "path": "third_party/bimmer-lab/apps/cluster_themes",
      "manifest": "app.json",
      "mguHmi": [
        "ID7"
      ],
      "build": {
        "python": "tools/build_source_ru.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      },
      "icon": "icon.png",
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "cluster-render": "0.5.1"
      }
    },
    {
      "id": "idrive_hud_widgets",
      "kind": "app",
      "path": "third_party/bimmer-lab/apps/idrive_hud_widgets",
      "manifest": "app.json",
      "mguHmi": [
        "ID7"
      ],
      "build": {
        "python": "tools/build_source_ru.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      },
      "icon": "icon.png",
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "cluster-render": "0.5.1"
      }
    }
  ]
}
