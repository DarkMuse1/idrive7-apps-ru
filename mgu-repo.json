{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "requires": {
      "idrive7-renderd": "2.1.10",
      "mgu-inputgate": "1.0.0"
    },
    "build": {
      "python": "tools/build_official_ru.py",
      "args": [
        "{id}",
        "--language",
        "ru"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": [
        "doom"
      ]
    },
    "exclude": [
      "ambient_light",
      "light_show",
      "drive_recorder_lab",
      "mgu_unified",
      "aa_cluster_companion"
    ]
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps",
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/prebuilt",
      "version": "1.0.0",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "mguHmi": [
        "ID7"
      ],
      "preload": {
        "library": "mgu-inputgate.so",
        "unit": "hmi.service",
        "process": "HmiMain3D",
        "strikes": 2,
        "checkAfterSeconds": 120,
        "healthySeconds": 60
      }
    },
    {
      "id": "mgu-ambient-rgb",
      "path": "tools/mgu-ambient-rgb"
    }
  ],
  "components": [
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0",
        "mgu-ambient-rgb": "0.1.2"
      },
      "build": {
        "python": "tools/protected-apps/kit/tools/build.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "network": [
          "doom"
        ]
      },
      "id": "ambient_light",
      "kind": "app",
      "path": "apps/ambient_light"
    },
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "tools/build_drive_recorder.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      },
      "id": "drive_recorder_lab",
      "kind": "app",
      "path": "apps/drive_recorder_lab"
    },
    {
      "id": "light_show",
      "kind": "app",
      "path": "apps/light_show",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "uninstallable": true,
      "requires": {
        "mgu-deploy": "0.7.5"
      },
      "build": {
        "python": "tools/build_light_show.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      }
    },
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0"
      },
      "id": "mgu_unified",
      "kind": "app",
      "path": "apps/mgu_unified",
      "build": {
        "python": "tools/protected-apps/kit/tools/build.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      }
    },
    {
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.10",
        "mgu-inputgate": "1.0.0"
      },
      "id": "aa_cluster_companion",
      "kind": "app",
      "path": "apps/aa_cluster_companion",
      "build": {
        "python": "tools/protected-apps/kit/tools/build.py",
        "args": [
          "{id}",
          "--language",
          "ru"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz"
      }
    }
  ]
}
