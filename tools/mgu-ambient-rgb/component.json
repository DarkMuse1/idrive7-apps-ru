{
  "id": "mgu-ambient-rgb",
  "kind": "tool",
  "version": "0.1.1",
  "title": "Загрузчик закрытой RGB-подсветки",
  "description": "Загружает локальную службу из защищённого приложения после ввода пароля; рабочего RGB-кода в этом компоненте нет.",
  "mguHmi": [
    "ID7"
  ],
  "optional": true,
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "native-loader.js",
      "from": "native-loader.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "mgu-ambient-rgb.service",
      "from": "mgu-ambient-rgb.service"
    }
  ],
  "enable": [
    {
      "unit": "mgu-ambient-rgb.service",
      "target": "oapcontroller.service"
    }
  ],
  "restart": [
    "mgu-ambient-rgb.service"
  ]
}
